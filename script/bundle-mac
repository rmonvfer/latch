#!/usr/bin/env bash
# Build the app and wrap it in a macOS .app bundle. Running from the bundle
# is what lets macOS deliver the app's notifications.
#
#   script/bundle-mac            release build → target/release/Latch.app
#   script/bundle-mac --debug    debug build   → target/debug/Latch.app
set -euo pipefail

cd "$(dirname "$0")/.."

profile=release
cargo_flags=(--release)
if [[ "${1:-}" == "--debug" ]]; then
  profile=debug
  cargo_flags=()
fi

signing_identity=${LATCH_SIGNING_IDENTITY:-}
signing_keychain=()
identity_keychain=()
if [[ -n "${LATCH_SIGNING_KEYCHAIN:-}" ]]; then
  signing_keychain=(--keychain "$LATCH_SIGNING_KEYCHAIN")
  identity_keychain=("$LATCH_SIGNING_KEYCHAIN")
fi
if [[ -z "$signing_identity" ]]; then
  identities=$(security find-identity -v -p codesigning "${identity_keychain[@]+"${identity_keychain[@]}"}" | \
    sed -n 's/.*) \([A-F0-9]*\) "Developer ID Application:.*"/\1/p')
  identity_count=$(printf '%s\n' "$identities" | sed '/^$/d' | wc -l | tr -d ' ')
  if [[ "$identity_count" -gt 1 ]]; then
    echo "Multiple Developer ID identities are available; set LATCH_SIGNING_IDENTITY" >&2
    exit 1
  fi
  signing_identity=${identities:--}
fi

cargo build --locked "${cargo_flags[@]+"${cargo_flags[@]}"}"

name="Latch"
identifier="me.egrati.terminal"
executable="terminal"
version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)
build_number=${LATCH_BUILD_NUMBER:-$version}
if [[ ! "$build_number" =~ ^[0-9]+(\.[0-9]+){0,2}$ ]]; then
  echo "LATCH_BUILD_NUMBER must contain one to three numeric components" >&2
  exit 1
fi
# The runtime authenticates peers by executable path, so the bundle location is stable.
bundle="target/$profile/Latch.app"

mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Resources"
cp LICENSE "$bundle/Contents/Resources/LICENSE"
cp assets/themes/LICENSES "$bundle/Contents/Resources/THEME-LICENSES"
cp "target/$profile/$executable" "$bundle/Contents/MacOS/$executable.tmp"
mv "$bundle/Contents/MacOS/$executable.tmp" "$bundle/Contents/MacOS/$executable"
xcrun actool assets/app-icon/Latch.icon \
  --compile "$bundle/Contents/Resources" \
  --app-icon Latch \
  --platform macosx \
  --minimum-deployment-target 13.0 \
  --output-partial-info-plist "target/$profile/latch-icon-info.plist" \
  --output-format human-readable-text \
  --warnings --errors

cat > "$bundle/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>$name</string>
  <key>CFBundleDisplayName</key><string>$name</string>
  <key>CFBundleIdentifier</key><string>$identifier</string>
  <key>CFBundleExecutable</key><string>$executable</string>
  <key>CFBundleIconFile</key><string>Latch.icns</string>
  <key>CFBundleIconName</key><string>Latch</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$version</string>
  <key>CFBundleVersion</key><string>$build_number</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
PLIST

# The signature lets macOS treat the bundle as one app across launches.
signing_options=()
if [[ "$signing_identity" != "-" ]]; then
  signing_options=(--timestamp --options runtime)
fi
codesign --force --sign "$signing_identity" \
  "${signing_keychain[@]+"${signing_keychain[@]}"}" \
  "${signing_options[@]+"${signing_options[@]}"}" "$bundle" >/dev/null
codesign --verify --deep --strict "$bundle"
echo "$bundle"
