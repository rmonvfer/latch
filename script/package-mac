#!/usr/bin/env bash
# Package the signed bundle with its resource forks and a SHA-256 checksum.
set -euo pipefail
cd "$(dirname "$0")/.."

tag=${1:?usage: script/package-mac release-tag}
if [[ "${LATCH_REQUIRE_UPDATE_SIGNATURE:-0}" == 1 && -z "${SPARKLE_PRIVATE_KEY:-}" ]]; then
  echo "SPARKLE_PRIVATE_KEY is required for update publishing" >&2
  exit 1
fi
if [[ ! "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-beta\.[0-9]+)?$ ]]; then
  echo "Expected a version tag such as v0.1.0 or v0.1.0-beta.1" >&2
  exit 1
fi
if [[ "$tag" == *-beta.* ]]; then
  export LATCH_UPDATE_CHANNEL=beta
else
  export LATCH_UPDATE_CHANNEL=production
fi
if [[ "${LATCH_REQUIRE_NOTARIZATION:-0}" == 1 && -z "${LATCH_NOTARY_PROFILE:-}" ]]; then
  echo "LATCH_NOTARY_PROFILE is required for notarized packaging" >&2
  exit 1
fi

script/bundle-mac
bundle=target/release/Latch.app
plutil -lint "$bundle/Contents/Info.plist"
codesign --verify --deep --strict "$bundle"
if [[ "${LATCH_REQUIRE_DEVELOPER_ID:-0}" == 1 ]]; then
  script/verify-mac-signature "$bundle"
fi
architecture=$(uname -m)
case "$architecture" in
  arm64|x86_64) ;;
  *) echo "Unsupported macOS architecture: $architecture" >&2; exit 1 ;;
esac
actual_architecture=$(lipo -archs "$bundle/Contents/MacOS/terminal")
if [[ "$actual_architecture" != "$architecture" ]]; then
  echo "Bundle architecture $actual_architecture does not match $architecture" >&2
  exit 1
fi

mkdir -p target/dist
archive="Latch-$tag-macos-$architecture.zip"
ditto -c -k --sequesterRsrc --keepParent "$bundle" "target/dist/$archive"
if [[ -n "${LATCH_NOTARY_PROFILE:-}" ]]; then
  notary_keychain=()
  if [[ -n "${LATCH_NOTARY_KEYCHAIN:-}" ]]; then
    notary_keychain=(--keychain "$LATCH_NOTARY_KEYCHAIN")
  fi
  notary_result=$(mktemp)
  trap 'rm "$notary_result"' EXIT
  xcrun notarytool submit "target/dist/$archive" \
    --keychain-profile "$LATCH_NOTARY_PROFILE" \
    "${notary_keychain[@]+"${notary_keychain[@]}"}" \
    --wait --output-format json > "$notary_result"
  python3 - "$notary_result" <<'PY'
import json
import sys

with open(sys.argv[1]) as result_file:
    result = json.load(result_file)
if result.get("status") != "Accepted":
    raise SystemExit(f"Notarization was not accepted: {result.get('status', 'unknown')}")
PY
  xcrun stapler staple "$bundle"
  xcrun stapler validate "$bundle"
  spctl --assess --type execute --verbose "$bundle"
  ditto -c -k --sequesterRsrc --keepParent "$bundle" "target/dist/$archive"
fi
(cd target/dist && shasum -a 256 "$archive" > "$archive.sha256")
if [[ -n "${SPARKLE_PRIVATE_KEY:-}" ]]; then
  sparkle_directory=$(script/prepare-sparkle)
  signature=$(printf '%s' "$SPARKLE_PRIVATE_KEY" | \
    "$sparkle_directory/bin/sign_update" --ed-key-file - -p "target/dist/$archive")
  feed="target/dist/$LATCH_UPDATE_CHANNEL-$architecture.xml"
  build_number=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$bundle/Contents/Info.plist")
  python3 script/update-feed.py --channel "$LATCH_UPDATE_CHANNEL" \
    --architecture "$architecture" --tag "$tag" --build "$build_number" \
    --archive "target/dist/$archive" --signature "$signature" --output "$feed"
  printf '%s' "$SPARKLE_PRIVATE_KEY" | \
    "$sparkle_directory/bin/sign_update" --ed-key-file - "$feed"
fi
echo "target/dist/$archive"
